{
  "PProf": {
    "Open": true,
    "ServerAddr": ":6060"
  },
  "Log": {
    "Path": "./log/stevedore.log",
    "Level": "debug",
    "Verbose": false,
    "MaxAgeHour": 24,
    "RotationTimeHour": 168,
    "UploadStatsIntervalSec": 0
  },
  "Server": {
    "ListenAddr": "0.0.0.0:2614",
    "ListenParallel": 4,
    "EventSize": 1024,
    "BatchSize": 32,
    "BufSize": 4096,
    "MaxRecvBatchesPerFD": 8,
    "MaxTryTimes": 3
  },
  "Session": {
    "RecycleIntervalSec": 10,
    "TimeoutSec": 30
  },
  "Upload": {
    "DefaultUpstream": "drop",
    "Routes": [
      {
        "Name": "default-magic",
        "Conditions": [
          {
            "KeyBytes": "0:1",
            "Operator": "==",
            "Value": "0x69"
          }
        ],
        "Upstream": "default"
      },
      {
        "Name": "rr-sample-magic",
        "Conditions": [
          {
            "KeyBytes": "1:4",
            "Operator": "==",
            "Value": "0x998877"
          }
        ],
        "Upstream": "rr_sample"
      }
    ],
    "Upstreams": [
      {
        "Name": "default",
        "Type": "chash",
        "KeyBytes": "1:2,3:4",
        "KeyMask": "0xff0f",
        "InvalidKeyPolicy": "drop",
        "HealthChecker": {
          "HeartbeatIntervalSec": 5,
          "HeartbeatTimeoutSec": 3,
          "SuccessTimes": 1,
          "FailedTimes": 1
        },
        "Peers": [
          {
            "IP": "10.0.0.1",
            "Port": 2345,
            "Weight": 1,
            "Backup": true
          },
          {
            "IP": "10.0.0.2",
            "Port": 2345,
            "Weight": 1,
            "Backup": false
          }
        ]
      },
      {
        "Name": "rr_sample",
        "Type": "rr",
        "HealthChecker": {
          "HeartbeatIntervalSec": 5,
          "HeartbeatTimeoutSec": 3,
          "SuccessTimes": 1,
          "FailedTimes": 1
        },
        "Peers": [
          {
            "IP": "2001:db8::3",
            "Port": 2345,
            "Weight": 1,
            "Backup": true
          },
          {
            "IP": "10.0.0.4",
            "Port": 2345,
            "Weight": 1,
            "Backup": false
          }
        ]
      }
    ]
  }
}
